      "cell_type": "code",
      "source": [
        "from google.colab import drive\n",
        "import os\n",
        "import requests\n",
        "from PIL import Image\n",
        "from io import BytesIO\n",
        "\n",
        "\n",
        "# Step 1: Mount Google Drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "\n",
        "# Step 2: Define input and output folders\n",
        "input_folder_path = '/content/drive/MyDrive/Rams Horn/Input B&W/'  # Local path to your input folder\n",
        "output_folder_path = '/content/drive/MyDrive/Rams Horn/Color/'      # Local path to your output folder\n",
        "\n",
        "\n",
        "# Step 3: Check if input folder exists\n",
        "if not os.path.exists(input_folder_path):\n",
        "    print(f\"Input folder does not exist: {input_folder_path}\")\n",
        "else:\n",
        "    print(f\"Input folder exists: {input_folder_path}\")\n",
        "\n",
        "\n",
        "# Function to download an image from a URL\n",
        "def download_image(url):\n",
        "    response = requests.get(url)  # Fetch the image\n",
        "    if response.status_code == 200:\n",
        "        img = Image.open(BytesIO(response.content))  # Open the image\n",
        "        return img\n",
        "    else:\n",
        "        print(\"Failed to download image\")\n",
        "        return None\n",
        "\n",
        "\n",
        "# Function to colorize and save images\n",
        "def colorize_and_save_image(input_file_path, output_folder, render_factor=35, watermarked=True):\n",
        "    try:\n",
        "        # Use the colorizer to process the image\n",
        "        colorized_image_path = colorizer.plot_transformed_image_from_url(\n",
        "            url=f\"file://{input_file_path}\",  # Pass the local file path as a URL\n",
        "            render_factor=render_factor,\n",
        "            compare=False,\n",
        "            watermarked=watermarked\n",
        "        )\n",
        "\n",
        "        # Save the colorized image to the output folder\n",
        "        output_file_path = os.path.join(output_folder, os.path.basename(input_file_path))\n",
        "        os.rename(colorized_image_path, output_file_path)  # Move the colorized image to the output folder\n",
        "        print(f\"Colorized image saved to {output_file_path}\")\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"Error during colorization: {e}\")\n",
        "\n",
        "\n",
        "# Step 4: Process each image in the input folder\n",
        "for filename in os.listdir(input_folder_path):\n",
        "    if filename.lower().endswith(('.png', '.jpg', '.jpeg')):  # Check for image files\n",
        "        input_file_path = os.path.join(input_folder_path, filename)\n",
        "        colorize_and_save_image(input_file_path, output_folder_path)  # Process the image"
